# AI LeadEngage - Environment Variables
NODE_ENV=development
PORT=5000

# Database
# For local zero-config SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_leadengage?schema=public"

# Authentication
JWT_SECRET="ai-leadengage-super-secret-jwt-key-change-in-prod-2026"
JWT_EXPIRES_IN="7d"

# OpenAI API
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# WhatsApp Cloud API (Meta)
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="leadengage_webhook_verify_token_2026"

# Redis & Queue
REDIS_URL="redis://localhost:6379"
USE_REDIS_QUEUE=false

# System
DEMO_MODE=true
APP_URL="http://localhost:5173"

